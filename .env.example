DATABASE_URL=postgresql+psycopg://rcc:rcc_dev_password@db:5432/rcc
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SESSION_SECRET=replace-with-a-long-random-session-secret
JWT_SECRET=replace-with-a-different-long-random-jwt-secret
ACCESS_TOKEN_MINUTES=10080
TOKEN_ENCRYPTION_KEY=replace-with-a-third-long-random-secret
REDIS_URL=redis://redis:6379/0
GOOGLE_CLIENT_SECRETS_FILE=secrets/google_client_secret.json
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/integrations/youtube/callback
# Must use the same hostname as META_REDIRECT_URI below and the frontend's
# NEXT_PUBLIC_API_URL (docker-compose.yml) — the Meta OAuth session cookie is
# host-only, so mixing 127.0.0.1 and localhost across these breaks the OAuth
# state check with "Nieprawidłowy stan OAuth" (ADR-024). GOOGLE_REDIRECT_URI
# above is unaffected — YouTube's OAuth doesn't route through the frontend.
FRONTEND_URL=http://localhost:3000
OAUTH_INSECURE_TRANSPORT=true
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/api/platforms/meta/callback
META_GRAPH_API_VERSION=v19.0
# Only set this if your Meta app exposes "Facebook Login for Business" with
# Configurations instead of the classic scope-based Login product (no Valid
# OAuth Redirect URIs / permissions fields under Settings — only a
# Configurations tab). For Instagram 0.8.3 the active Configuration must grant:
# pages_show_list, business_management, pages_read_engagement, instagram_basic,
# instagram_manage_comments and read_insights. After changing the
# Configuration, remove the old RCC Business Integration grant and reconnect so
# Meta issues a new token. Leave empty to use the classic scope-based flow.
META_LOGIN_CONFIG_ID=
# Automatic Facebook + Instagram content/comment synchronization. It uses the
# same code path as the manual button and is opt-in, like YouTube's scheduler.
META_SYNC_ENABLED=false
META_SYNC_INTERVAL_HOURS=6
